; HeaderInclude
; config/pdp11/pdp11-opts.h

;; mcpu=:

;; Target RejectNegative Joined Enum(target_device) Init(unk_device)
;;S pecify the target CPU.

; Bit flags that specify the PDP-11 model we are compiling for.
Variable
int pdp11_model = OPTION_MASK_M11_45

m10
Target RejectNegative Negative(mbm1a) Mask(M11_10) Var(pdp11_model) Save
Generate code for an 11/10.

mbm1a
Target RejectNegative Negative(mbm1) Mask(1801BM1A) InverseMask(FPU) Var(pdp11_model) Save
Generate code for Soviet 1801BM1A (no MUL support)

mbm1
Target RejectNegative Negative(mbm1g) Alias(mbm1a) Save
Generate code for Soviet 1801BM1 aka 1801BM1A


mbm1g
Target RejectNegative Negative(mbm2) Mask(1801BM1G) InverseMask(FPU) Var(pdp11_model) Save
Generate code for Soviet 1801BM1Г (supports MUL, not DIV)

mbm2
Target RejectNegative Negative(m40) Mask(1801BM2) InverseMask(FPU) Var(pdp11_model) Save
Generate code for Soviet 1801BM2.

m40
Target RejectNegative Mask(M11_40) Negative(m45)  Var(pdp11_model) Save
Generate code for an 11/40.

m45
Target RejectNegative Mask(M11_45) Negative(m10)  Var(pdp11_model) Save
Generate code for an 11/45.

mac0
Target Mask(AC0)
Return floating-point results in ac0 (fr0 in Unix assembler syntax).

mdec-asm
Target RejectNegative Mask(DEC_ASM) Negative(mgnu-asm)
Use the DEC assembler syntax.

mgnu-asm
Target RejectNegative Mask(GNU_ASM) Negative(munix-asm)
Use the GNU assembler syntax.

mfpu
Target RejectNegative Mask(FPU)
Use hardware floating point.

mint16
Target InverseMask(INT32, INT16)
Use 16 bit int.

mint32
Target Mask(INT32)
Use 32 bit int.

msoft-float
Target RejectNegative InverseMask(FPU, SOFT_FLOAT)
Do not use hardware floating point.

msplit
Target Mask(SPLIT)
Target has split I&D.

munix-asm
Target RejectNegative Mask(UNIX_ASM) Negative(mdec-asm)
Use UNIX assembler syntax.

mlra
Target Mask(LRA)
Use LRA register allocator.
